sequenceDiagram
autonumber
actor U as user
participant R as Restaurant
participant M as Menu
participant O as Order

U->>R: viewing restaurant
R->>M: load menu
M-->>U: show Items, price and offers
U->>U: selectItem()
U->>O: send_items()
activate O
O->>O: grouping_Items()
O->>M: get price and offers of selected Items
M-->>O: price and offers
O->>O: sub_total()
O-->>U: show sub_total
U->>O: send_order()
O->>O: create_order()
O->>R: forward order
activate R
R->>R: receive_order()

alt Restaurant accepts the order
    R->>R: confirmed_order()
    R->>R: update_order_status("confirmed")
    R->>O: status update
    O->>O: changeStatus()
    O-->>U: Notify_user("order confirmed")
else Restaurant rejects the order
    R->>R: update_order_status("rejected")
    R->>O: status update
    O->>O: changeStatus()
    O-->>U: Notify_user("order rejected")
end

deactivate R
deactivate O
U->>U: track_order_number()
U->>O: request status (tracking_number)
O-->>U: status
