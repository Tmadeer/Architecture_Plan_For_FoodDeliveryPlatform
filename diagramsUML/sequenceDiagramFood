sequenceDiagram
    autonumber
    actor User as User
    participant Menu as Menu
    participant Order as Order
    participant Restaurant as Restaurant

    %% 1. Browsing & Selection Phase
    User->>Restaurant: viewing()
    User->>Menu: select_items() / group_item()
    Menu-->>User: Return selected items and quantities

    %% 2. Order Creation Phase
    User->>Order: send_order() / create_order()
    Note over Order: Order Status: created
    Order-->>User: Notification: Your order has been created successfully and is pending review.

    %% 3. Restaurant Decision (Accept / Reject)
    Restaurant->>Order: receive_order()
    
    alt Order Accepted
        Restaurant->>Order: confirmed_order() / change_status(confirmed)
        Note over Order: Order Status: confirmed
        Order-->>User: Notification: Your order has been confirmed by the restaurant!

        %% Order Progression States
        Note over Order: Order Status: prepared
        Order-->>User: Notification: Your order is now being prepared.

        Note over Order: Order Status: delivered
        Order-->>User: Notification: Your order has been delivered successfully. Enjoy your meal!

    else Order Rejected
        Restaurant->>Order: update_order_status(rejected)
        Note over Order: Order Status: rejected
        Order-->>User: Notification: Sorry, your order was rejected by the restaurant.
    end

    %% 4. Tracking Phase
    User->>Order: track_order()
    Order-->>User: Return final order status
