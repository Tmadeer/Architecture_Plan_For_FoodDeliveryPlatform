classDiagram
direction TB

    class user {
        -int user_id
        -str name
        -int phone_number
        -str address
        -str email
        -str password
        +track_order_number()
        +selectItem()
        +send_order()
    }

    class Menu {
        +str Items
        +float price
        +float offers
    }

    class Restaurant {
        +str restaurant_name
        -receive_order()
        -confirmed_order()
        -update_order_status()
    }

    class Order {
        -int tracking_number
        -OrderState state
        -sub_total()
        -grouping_Items()
        -changeStatus()
        +setState(OrderState state)
        +create_order()
        +Notify_user()
    }

    class orderHistory {
        -int user_id
        -list past_orders
        +add_order(Order order)
        +get_order_history()
        +view_details(int tracking_number)
    }

    class OrderState {
        <<abstract>>
        +getName() str
        +next(Order order)
    }

    class Created {
        +next(Order order)
    }

    class Confirmed {
        +next(Order order)
    }

    class Prepared {
        +next(Order order)
    }

    class Delivered {
        +next(Order order)
    }

    %% user relations
    user "1" --> "*" Order : places
    user "1" -- "1" orderHistory : has

    %% order relations
    orderHistory "1" o-- "*" Order : contains
    Order "*" --> "1"
